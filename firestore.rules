rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function user(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function admin(){ return signedIn() && user().role == 'admin' && user().status == 'approved'; }
  function owner(data){ return signedIn() && data.courierId == request.auth.uid; }
  function sameCourier(){ return request.resource.data.courierId == resource.data.courierId; }
  match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == 'courier' && request.resource.data.status == 'pending'; allow update: if admin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','updatedAt'])); allow delete: if false; }
  match /couriers/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow create: if signedIn() && request.auth.uid == uid && request.resource.data.courierId == uid; allow update: if (owner(resource.data) && sameCourier() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','vehicle','vehicleModel','color','plates','profilePhotoUrl','updatedAt'])) || admin(); allow delete: if false; }
  match /clients/{id} { allow read: if owner(resource.data) || admin(); allow create: if owner(request.resource.data); allow update: if (owner(resource.data) && sameCourier()) || admin(); allow delete: if false; }
  match /orders/{id} { allow read: if owner(resource.data) || admin(); allow create: if owner(request.resource.data) && request.resource.data.clientConfirmed == false; allow update: if admin() || (owner(resource.data) && sameCourier() && request.resource.data.clientConfirmed == resource.data.clientConfirmed && request.resource.data.clientConfirmedAt == resource.data.clientConfirmedAt && request.resource.data.archived == resource.data.archived); allow delete: if false;
    match /history/{eventId} { allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/orders/$(id)).data.courierId == request.auth.uid); allow create: if admin() || (signedIn() && request.resource.data.courierId == request.auth.uid && get(/databases/$(database)/documents/orders/$(id)).data.courierId == request.auth.uid); allow update, delete: if false; }
  }
  match /ratings/{id} { allow read: if owner(resource.data) || admin(); allow write: if false; }
  match /complaints/{id} { allow read: if owner(resource.data) || admin(); allow update: if admin(); allow create, delete: if false; }
  match /licenses/{courierId} { allow read: if signedIn() && (request.auth.uid == courierId || admin()); allow write: if admin(); }
  match /courierAccessRoutes/{token} { allow read, write: if admin(); }
  match /auditLogs/{id} { allow read, create: if admin(); allow update, delete: if false; }
  match /publicTracking/{token} { allow read: if true; allow write: if false; }
  match /{document=**} { allow read, write: if false; }
}}
