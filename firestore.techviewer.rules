rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';}
  function licensed(){return signedIn() && exists(/databases/$(database)/documents/techUsers/$(request.auth.uid)) && get(/databases/$(database)/documents/techUsers/$(request.auth.uid)).data.status == 'active' && get(/databases/$(database)/documents/techUsers/$(request.auth.uid)).data.expiresAt is timestamp && get(/databases/$(database)/documents/techUsers/$(request.auth.uid)).data.expiresAt > request.time;}
  match /users/{uid} {allow get: if signedIn() && (request.auth.uid == uid || isAdmin()); allow list: if isAdmin(); allow write: if false;}
  match /techUsers/{uid} {allow get: if signedIn() && (request.auth.uid == uid || isAdmin());allow list: if isAdmin();allow create,update,delete: if isAdmin() && uid != request.auth.uid && request.resource.data.role == 'client';}
  match /techCatalog/{id} {allow read: if isAdmin() || licensed();allow create,update,delete: if isAdmin();}
  match /{document=**} {allow read,write: if false;}
 }
}
