// AGREGAR dentro de match /databases/{database}/documents de tus reglas ACTUALES.
// Requiere las funciones isAdmin() y signedIn() que ya existen.
match /techPayments/{paymentId} {
  allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
  allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','email','country','method','reference','amount','proofPath','status','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time
    && request.resource.data.country in ['MX','INT']
    && ((request.resource.data.country == 'MX' && request.resource.data.method == 'spei') || (request.resource.data.country == 'INT' && request.resource.data.method == 'paypal'))
    && request.resource.data.reference is string && request.resource.data.reference.size() > 0 && request.resource.data.reference.size() <= 150
    && request.resource.data.amount is string && request.resource.data.amount.size() > 0 && request.resource.data.amount.size() <= 30
    && request.resource.data.proofPath is string
    && request.resource.data.proofPath.matches('techPaymentProofs/' + request.auth.uid + '/' + paymentId + '[.](jpg|png|pdf)');
  allow update: if isAdmin() && resource.data.status == 'pending'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedAt','reviewedBy'])
    && request.resource.data.status in ['approved','rejected']
    && request.resource.data.reviewedBy == request.auth.uid
    && request.resource.data.reviewedAt == request.time;
  allow delete: if false;
}
