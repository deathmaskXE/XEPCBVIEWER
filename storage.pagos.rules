rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';}
  match /techPaymentProofs/{uid}/{fileName} {
   allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
   allow create: if signedIn() && request.auth.uid == uid
      && fileName.matches('[A-Za-z0-9_-]+[.](jpg|png|pdf)')
      && request.resource.size <= 5 * 1024 * 1024
      && request.resource.contentType in ['image/jpeg','image/png','application/pdf'];
   allow update, delete: if false;
  }
 }
}
